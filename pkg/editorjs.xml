<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="editors" method="upgrade">
	<name>plg_editors_editorjs</name>
	<version>1.0.0</version>
	<creationDate>2026-11</creationDate>
	<author>COLORPACK CREATION CO., LTD.</author>
	<authorUrl>https://colorpack.co.th</authorUrl>
	<copyright>(C) 2026 COLORPACK CREATION CO., LTD.</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>PLG_EDITORS_EDITORJS_XML_DESCRIPTION</description>
	<namespace path="src">Colorpack\Plugin\Editors\Editorjs</namespace>
	<scriptfile>script.php</scriptfile>
	<files>
		<folder plugin="editorjs">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_editors_editorjs" folder="media">
		<folder>js</folder>
		<folder>css</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="upload_folder" type="text" default="images/editorjs" label="PLG_EDITORS_EDITORJS_UPLOAD_FOLDER_LABEL" description="PLG_EDITORS_EDITORJS_UPLOAD_FOLDER_DESC"/>
				<field name="table_class" type="text" default="uk-table uk-table-divider table" label="PLG_EDITORS_EDITORJS_TABLE_CLASS_LABEL" description="PLG_EDITORS_EDITORJS_TABLE_CLASS_DESC"/>
			</fieldset>
		</fields>
	</config>
</extension>
